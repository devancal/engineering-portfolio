{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/Devan-Calabrese-Resume.pdf",
      "destination": "/Calabrese_Devan_Resume.pdf",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {"key":"Cache-Control","value":"no-cache, no-store, must-revalidate"},
        {"key":"X-Content-Type-Options","value":"nosniff"}
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {"key":"X-Content-Type-Options","value":"nosniff"}
      ]
    }
  ]
}
